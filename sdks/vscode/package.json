{
  "name": "abxglia-opencode",
  "displayName": "Abxglia OpenCode",
  "description": "opencode for VS Code (abxglia dev fork)",
  "version": "1.18.4",
  "publisher": "abxglia",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhi152003/opencode"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "abxglia-opencode.openTerminal",
        "title": "Abxglia: Open opencode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "abxglia-opencode.openNewTerminal",
        "title": "Abxglia: Open opencode in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "abxglia-opencode.addFilepathToTerminal",
        "title": "Abxglia: Add Filepath to Terminal"
      },
      {
        "command": "abxglia-opencode.acceptChange",
        "title": "Abxglia: Accept Change",
        "icon": "$(check)"
      },
      {
        "command": "abxglia-opencode.acceptAlwaysChange",
        "title": "Abxglia: Accept Change (Always)",
        "icon": "$(check-all)"
      },
      {
        "command": "abxglia-opencode.rejectChange",
        "title": "Abxglia: Reject Change",
        "icon": "$(close)"
      },
      {
        "command": "abxglia-opencode.rejectChangeWithFeedback",
        "title": "Abxglia: Reject Change with Feedback"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "abxglia-opencode.openNewTerminal",
          "group": "navigation"
        },
        {
          "command": "abxglia-opencode.acceptChange",
          "group": "navigation@1",
          "when": "resourceScheme == opencodediff"
        },
        {
          "command": "abxglia-opencode.acceptAlwaysChange",
          "group": "navigation@2",
          "when": "resourceScheme == opencodediff"
        },
        {
          "command": "abxglia-opencode.rejectChange",
          "group": "navigation@3",
          "when": "resourceScheme == opencodediff"
        }
      ]
    },
    "keybindings": [
      {
        "command": "abxglia-opencode.openTerminal",
        "title": "Run opencode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "abxglia-opencode.openNewTerminal",
        "title": "Run opencode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "abxglia-opencode.addFilepathToTerminal",
        "title": "Abxglia: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      },
      {
        "command": "abxglia-opencode.acceptChange",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "win": "ctrl+enter",
        "linux": "ctrl+enter",
        "when": "resourceScheme == opencodediff"
      },
      {
        "command": "abxglia-opencode.acceptAlwaysChange",
        "key": "cmd+shift+enter",
        "mac": "cmd+shift+enter",
        "win": "ctrl+shift+enter",
        "linux": "ctrl+shift+enter",
        "when": "resourceScheme == opencodediff"
      },
      {
        "command": "abxglia-opencode.rejectChange",
        "key": "cmd+shift+backspace",
        "mac": "cmd+shift+backspace",
        "win": "ctrl+shift+backspace",
        "linux": "ctrl+shift+backspace",
        "when": "resourceScheme == opencodediff"
      }
    ],
    "configuration": {
      "title": "Abxglia OpenCode",
      "properties": {
        "abxglia-opencode.ideDiffReview": {
          "type": "boolean",
          "default": true,
          "description": "Show proposed file changes as a diff tab in the editor before they are written, with Accept/Reject controls."
        },
        "abxglia-opencode.path": {
          "type": "string",
          "default": "opencode",
          "description": "Path to the opencode binary. Override to point at a local dev build, e.g. \"bun run --cwd /path/to/opencode packages/opencode/src/index.ts\"."
        },
        "abxglia-opencode.dataDir": {
          "type": "string",
          "default": "",
          "description": "Override the opencode data directory to isolate this dev fork from the released opencode. Set to e.g. \"~/.local/share/abxglia-opencode\". Maps to the OPENCODE_DATA_DIR env var."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.57.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
